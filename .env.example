# =============================================================================
# Agent Autopsy — Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values.
# DO NOT commit your actual .env file to version control.

# -- Application --------------------------------------------------------------
APP_NAME=Agent Autopsy
APP_VERSION=1.0.0
DEBUG=false
LOG_LEVEL=INFO

# -- API Configuration ---------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=8000

# -- Streamlit Configuration --------------------------------------------------
STREAMLIT_HOST=0.0.0.0
STREAMLIT_PORT=8501

# -- Langfuse (required) ------------------------------------------------------
LANGFUSE_PUBLIC_KEY=pk-lf-xxxxxxxx
LANGFUSE_SECRET_KEY=sk-lf-xxxxxxxx
LANGFUSE_BASE_URL=https://cloud.langfuse.com
LANGFUSE_TIMEOUT=30.0

# -- LLM Explanation (optional) -----------------------------------------------
# Set LLM_ENABLED=true and provide a base URL to enable LLM explanations.
# The system works fully without LLM — explanations are supplementary only.
LLM_ENABLED=false
LLM_BASE_URL=http://localhost:11434
LLM_API_KEY=
LLM_MODEL=llama3
LLM_TIMEOUT=60.0
LLM_MAX_TOKENS=2048
LLM_API_VERSION=2024-08-01-preview  # Required for Azure OpenAI

# -- Database (optional) ------------------------------------------------------
# DATABASE_URL=postgresql://user:password@localhost:5432/agent_autopsy

# -- Security -----------------------------------------------------------------
# Generate a secret key for session management
SECRET_KEY=your-secret-key-here

# -- External Services ---------------------------------------------------------
# Add any external service URLs or API keys here
